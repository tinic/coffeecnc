{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "dev",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": true}
    },
    {"name": "asan", "inherits": "dev", "cacheVariables": {"COFFEECNC_SANITIZERS": "address;undefined"}},
    {"name": "tsan", "inherits": "dev", "cacheVariables": {"COFFEECNC_SANITIZERS": "thread"}},
    {
      "name": "msan",
      "inherits": "dev",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O1",
        "COFFEECNC_SANITIZERS": "memory",
        "COFFEECNC_MSAN_LIBCXX": "${sourceDir}/build/msan-libcxx",
        "COFFEECNC_LINUXCNC": "OFF",
        "COFFEECNC_SHELL": "OFF"
      }
    },
    {"name": "analyze", "inherits": "dev", "cacheVariables": {"COFFEECNC_ENABLE_ANALYZERS": true}},
    {"name": "package", "inherits": "dev", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "COFFEECNC_DEVELOPMENT_PATHS": false}}
  ],
  "buildPresets": [
    {"name": "dev", "configurePreset": "dev"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "tsan", "configurePreset": "tsan"},
    {"name": "msan", "configurePreset": "msan"},
    {"name": "analyze", "configurePreset": "analyze"},
    {"name": "package", "configurePreset": "package"}
  ],
  "testPresets": [
    {"name": "dev", "configurePreset": "dev", "output": {"outputOnFailure": true}},
    {"name": "asan", "configurePreset": "asan", "output": {"outputOnFailure": true}},
    {"name": "tsan", "configurePreset": "tsan", "output": {"outputOnFailure": true}},
    {"name": "msan", "configurePreset": "msan", "output": {"outputOnFailure": true}},
    {"name": "analyze", "configurePreset": "analyze", "output": {"outputOnFailure": true}},
    {"name": "package", "configurePreset": "package", "output": {"outputOnFailure": true}}
  ],
  "packagePresets": [
    {"name": "package", "configurePreset": "package", "generators": ["DEB"]}
  ]
}
