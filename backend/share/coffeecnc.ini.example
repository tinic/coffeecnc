# What a machine's INI file needs for CoffeeCNC. Not a complete INI file: put these keys into
# the sections of the machine's own.

[DISPLAY]
# LinuxCNC starts this program and shuts down when it exits. Options go after the name:
# --windowed (a 1280 x 800 window instead of the full screen).
DISPLAY = coffeecnc
# Read by coffeecnc: PROGRAM_PREFIX (the only directory programs are opened from),
# MAX_LINEAR_VELOCITY, INCREMENTS, MAX_FEED_OVERRIDE, MIN_SPINDLE_OVERRIDE,
# MAX_SPINDLE_OVERRIDE. Keys of other display programs are ignored.

[COFFEECNC]
# The highest spindle speed the panel accepts, in rpm. Without this key
# [SPINDLE_0] MAX_FORWARD_VELOCITY is taken, then [DISPLAY] MAX_SPINDLE_0_SPEED; with none of
# the three coffeecnc does not start.
MAX_SPINDLE_RPM = 1500
# Optional right-hand rigid tapping on spindle 0. Before setting both keys, qualify signed
# encoder feedback, index, at-speed, and commanded reversal on this machine. Measure the larger
# overrun in spindle revolutions at both reversals throughout the enabled range. CoffeeCNC
# requires spindle override off during G33.1. K multiplies the overrun to give axial clearance.
# RIGID_TAP_MAX_RPM = ...
# RIGID_TAP_REVERSAL_TURNS = ...
# Optional verified physical envelope for Program check. Each row is machine X Y Z in mm.
# Keep LinuxCNC's [AXIS_*] limits in effect separately. Without verified travel on a
# no-force-homing profile, CoffeeCNC reports physical travel as unverified.
# TRAVEL_MIN_MM = -160 -70 -100
# TRAVEL_MAX_MM = 160 70 0
# yes when the machine's HAL files connect a signal to the pin of the coffeecnc component;
# only then is the value shown. An unconnected pin is never taken for a measured zero.
#   SPINDLE_RPM_SIGNAL        coffeecnc.spindle-rpm       float in, measured rpm
#   SPINDLE_AT_SPEED_SIGNAL   coffeecnc.spindle-at-speed  bit in
#   PROBE_SIGNAL              coffeecnc.probe-input       bit in
SPINDLE_RPM_SIGNAL = no
SPINDLE_AT_SPEED_SIGNAL = no
PROBE_SIGNAL = no
# yes when the machine homes on reference marks that its HAL has to find first (linear scales
# with a single mark) and connects, for X, Y and Z, a bit that is true once the axis's mark is
# known to coffeecnc.reference-mark-x, -y and -z, and a bit that is true while the axis stands at
# its mark to coffeecnc.at-reference-mark-x, -y and -z. The Home button of an axis is then marked
# while the axis is at its mark, also with the machine off, and Home is refused until the mark
# is known.
#REFERENCE_MARKS = yes
# Opt into CoffeeCNC's manual tool-change prompt once LinuxCNC's tool-change,
# tool-changed and tool-prep-number pins are free. Leave off for an existing changer.
MANUAL_TOOLCHANGE = no
# Enable only after commissioning the configured fixed-setter HAL selector and motion permit.
# Set SETTER_MAX_TRAVEL_MM, SETTER_SEARCH_FEED_MM_MIN and SETTER_XY_TOLERANCE_MM to the machine's
# commissioned limits. SETTER_REFERENCE_TOOL defaults to 98.
# SETTER_CLEARANCE_MM lifts to tool-change height relative to the reference latch.
# SETTER_CHECK_TOLERANCE_MM is the maximum allowed length difference for Check length (default 0.1).
# SETTER_LATCH_FEED_MM_MIN enables a second pass after backing off by SETTER_LATCH_BACKOFF_MM (1 mm by default).
FIXED_SETTER = no
# The tool number HAL routes to a spindle touch probe. It is treated as a touch probe (no
# spindle start while loaded) whatever its tool model says.
#TOUCH_PROBE_TOOL = 99
# Optional motion tolerances in millimetres. These are the default values.
# PROBE_OFF_LINE_TOLERANCE_MM = 0.5
# PROBE_BACKLASH_TOLERANCE_MM = 0.5
# PROBE_POSITION_TOLERANCE_MM = 0.1
# RESTART_POSITION_TOLERANCE_MM = 0.5
# The side-probing approach used for corners, bosses, and the ball calibration gauge.
# TOUCH_PROBE_CORNER_REACH_MM = 10
# TOUCH_PROBE_CORNER_MARGIN_MM = 3
# TOUCH_PROBE_CLEARANCE_MM = 5
# TOUCH_PROBE_DEPTH_MM = 2
# The identity of this machine for what coffeecnc saves (the tool models of the Tools tab):
# a name that stays the same for this machine and that no other machine has. 1 to 64 of the
# characters A-Z a-z 0-9 _ and -, the first a letter or a digit; upper and lower case differ.
# When omitted, the ID comes from [EMC] MACHINE with a suffix based on the INI path.
# Set an explicit ID to keep the same data folder if you move the configuration.
#MACHINE_ID = my-mill
# Where the saved settings are kept: an absolute path; the machine's identity is appended as
# a directory of its own. Without this key it is $XDG_DATA_HOME/coffeecnc when that variable
# holds an absolute path, else ~/.local/share/coffeecnc. A path that is not absolute is not
# used: nothing is saved then, and the panel says why.
#DATA_DIRECTORY = /var/lib/coffeecnc
# Macro buttons in the MDI card of Manual: MACRO = <label> | <MDI block>, one line for each
# macro, at most 12. A label has at most 24 characters and is unique. The block is one MDI line of
# at most 254 bytes. The panel shows the block and runs it after a confirmation, with the same
# rules as a typed MDI command. For more steps, write a subroutine file and call it: the file
# <name>.ngc must be in [DISPLAY] PROGRAM_PREFIX or in a directory of [RS274NGC] SUBROUTINE_PATH,
# else coffeecnc does not start. Without MACRO lines the panel shows no macro button.
#MACRO = Park | G53 G0 Z0
#MACRO = Clamp check | O<clamp> call
# Extra rows of the HAL diagnostics view (menu, Diagnostics), after LinuxCNC's own limit, home,
# E-stop, probe and spindle pins: DIAGNOSTIC = <label> | <HAL signal or pin>, one line for each
# row, at most 16. A label has at most 32 characters and is unique. The name is looked up as a
# signal first, then as a pin; the view says when HAL has neither. Reading changes nothing in HAL.
#DIAGNOSTIC = E-stop button | estop-ext
#DIAGNOSTIC = VFD Modbus errors | vfd.modbus-errors

[HAL]
# Run by coffeecnc with halcmd once its HAL component exists; a path relative to the INI
# file's directory. The file must have the commands of
# /usr/share/coffeecnc/hal/coffeecnc_postgui.hal: copy that file beside the INI file, or
# `source` it from a file of the machine. Post-GUI files of another display program connect
# that program's pins and cannot be loaded.
# If lut5 is already loaded, include the named CoffeeCNC instances in its existing loadrt line.
# watchdog is a single shared component. Integrate the CoffeeCNC heartbeat and interlocks in
# the machine's watchdog wiring when it already uses watchdog. Omit duplicate loads and
# scheduling commands for components that are already set up by the machine.
POSTGUI_HALFILE = coffeecnc_postgui.hal
