# What a machine's INI file needs for CoffeeCNC. Not a complete INI file: put these keys into
# the sections of the machine's own.

[DISPLAY]
# LinuxCNC starts this program and shuts down when it exits. Options go after the name:
# --windowed (a 1280 x 800 window instead of the full screen).
DISPLAY = coffeecnc
# Read by coffeecnc: PROGRAM_PREFIX (the only directory programs are opened from),
# MAX_LINEAR_VELOCITY, INCREMENTS, MAX_FEED_OVERRIDE, MIN_SPINDLE_OVERRIDE,
# MAX_SPINDLE_OVERRIDE. Keys of other display programs are ignored.

[COFFEECNC]
# The highest spindle speed the panel accepts, in rpm. Without this key
# [SPINDLE_0] MAX_FORWARD_VELOCITY is taken, then [DISPLAY] MAX_SPINDLE_0_SPEED; with none of
# the three coffeecnc does not start.
MAX_SPINDLE_RPM = 1500
# yes when the machine's HAL files connect a signal to the pin of the coffeecnc component;
# only then is the value shown. An unconnected pin is never taken for a measured zero.
#   SPINDLE_RPM_SIGNAL        coffeecnc.spindle-rpm       float in, measured rpm
#   SPINDLE_AT_SPEED_SIGNAL   coffeecnc.spindle-at-speed  bit in
#   PROBE_SIGNAL              coffeecnc.probe-input       bit in
SPINDLE_RPM_SIGNAL = no
SPINDLE_AT_SPEED_SIGNAL = no
PROBE_SIGNAL = no
# Enable only after commissioning the configured fixed-setter HAL selector and motion permit.
# Set SETTER_MAX_TRAVEL_MM, SETTER_MAX_FEED_MM_MIN and SETTER_XY_TOLERANCE_MM to the machine's
# commissioned limits. SETTER_REFERENCE_TOOL defaults to 98.
FIXED_SETTER = no
# The identity of this machine for what coffeecnc saves (the tool models of the Tools tab):
# a name that stays the same for this machine and that no other machine has. 1 to 64 of the
# characters A-Z a-z 0-9 _ and -, the first a letter or a digit; upper and lower case differ.
# Without this key nothing is saved: the settings last until the panel closes. With a name
# that is not valid nothing is saved either, and the panel says why.
#MACHINE_ID = my-mill
# Where the saved settings are kept: an absolute path; the machine's identity is appended as
# a directory of its own. Without this key it is $XDG_DATA_HOME/coffeecnc when that variable
# holds an absolute path, else ~/.local/share/coffeecnc. A path that is not absolute is not
# used: nothing is saved then, and the panel says why.
#DATA_DIRECTORY = /var/lib/coffeecnc

[HAL]
# Run by coffeecnc with halcmd once its HAL component exists; a path relative to the INI
# file's directory. The file must have the commands of
# /usr/share/coffeecnc/hal/coffeecnc_postgui.hal: copy that file beside the INI file, or
# `source` it from a file of the machine. Post-GUI files of another display program connect
# that program's pins and cannot be loaded.
POSTGUI_HALFILE = coffeecnc_postgui.hal
