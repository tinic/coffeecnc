# Post-GUI wiring of CoffeeCNC on the G0759-shaped mill. Takes the place of the machine's
# gmoccapy post-GUI file; only one frontend's handshake pins may be connected at a time.

# Jog stop, watchdog and the manual tool change handshake, the same on every machine:
#   gmoccapy.toolchange-change   -> coffeecnc.tool-change
#   gmoccapy.toolchange-number   -> coffeecnc.tool-number
#   gmoccapy.toolchange-changed  -> coffeecnc.tool-changed
source coffeecnc_postgui.hal

# Kept from the machine's file: a prepared tool needs no action.
net tool-prep-loop iocontrol.0.tool-prepare => iocontrol.0.tool-prepared

# Signals the machine's HAL files already carry, declared in the INI file's [COFFEECNC] section.
# They replace the gmoccapy spindle bar, at-speed LED and the embedded rpm meter.
net spindle-vel-fb-rpm-abs => coffeecnc.spindle-rpm
net spindle-at-speed => coffeecnc.spindle-at-speed
net probe-in => coffeecnc.probe-input

# Keep the realtime Z offset permit tied to AUTO pause, spindle off and a live app.
addf coffeecnc-eoffset-gate servo-thread
setp coffeecnc-eoffset-gate.function 0x80
setp axis.z.eoffset-scale 0.001
net coffeecnc-eoffset-request coffeecnc.eoffset-z-enable => coffeecnc-eoffset-gate.in-0
net coffeecnc-watchdog-ok => coffeecnc-eoffset-gate.in-1
net coffeecnc-program-paused halui.program.is-paused => coffeecnc-eoffset-gate.in-2
net spindle-enable => coffeecnc-eoffset-gate.in-3
net coffeecnc-jog-stop => coffeecnc-eoffset-gate.in-4
net coffeecnc-eoffset-permit coffeecnc-eoffset-gate.out => axis.z.eoffset-enable
net coffeecnc-eoffset-counts coffeecnc.eoffset-z-counts => axis.z.eoffset-counts
net coffeecnc-eoffset-clear coffeecnc.eoffset-z-clear => axis.z.eoffset-clear
net coffeecnc-eoffset-z axis.z.eoffset => coffeecnc.eoffset-z
net coffeecnc-eoffset-active motion.eoffset-active => coffeecnc.eoffset-active
net coffeecnc-eoffset-limited motion.eoffset-limited => coffeecnc.eoffset-limited
