# Wires the coffeecnc HAL component into LinuxCNC. Run by the executable ([HAL] POSTGUI_HALFILE)
# once its component is ready.

# Jog stop without the NML command channel. motion.jog-stop is a level: while it is high every
# jog in motion is aborted. motion.jog-inhibit refuses a jog before it starts. Both are high
# while either of these holds:
#   coffeecnc.jog-stop    the executable has decided to stop jogs and holds the level until
#                         LinuxCNC's task has confirmed the stop
#   watchdog tripped      the executable died or stalled: coffeecnc.heartbeat stopped toggling
#
# A realtime module loads once per LinuxCNC: a second `loadrt` of a module the machine's own
# files load fails, with or without names=. Only two modules are loaded here, chosen because
# machine files rarely load them. A machine that does load one must ask for these instances in
# its own loadrt line instead:
#   watchdog  has no names= and is always the one instance `watchdog`
#   lut5      two named instances; the logic that `not` and `or2` would otherwise do
loadrt watchdog num_inputs=1
loadrt lut5 names=coffeecnc-jog-stop,coffeecnc-jog-inhibit
addf watchdog.process servo-thread
addf watchdog.set-timeouts servo-thread
addf coffeecnc-jog-stop servo-thread
addf coffeecnc-jog-inhibit servo-thread

# Twice the executable's 150 ms jog lease.
setp watchdog.timeout-0 0.3
# in-0 is watchdog ok, in-1 the executable's request, in-2 the simulated contact pulse.
setp coffeecnc-jog-stop.function 0xFD
# The same for inhibit: a jog start that LinuxCNC's task delivers late is refused, not started
# and aborted.
setp coffeecnc-jog-inhibit.function 0xD
net coffeecnc-heartbeat coffeecnc.heartbeat => watchdog.input-0
net coffeecnc-watchdog-enable coffeecnc.watchdog-enable => watchdog.enable-in
net coffeecnc-watchdog-ok watchdog.ok-out => coffeecnc.watchdog-ok
net coffeecnc-watchdog-ok => coffeecnc-jog-stop.in-0 coffeecnc-jog-inhibit.in-0
net coffeecnc-jog-stop-request coffeecnc.jog-stop => coffeecnc-jog-stop.in-1
net coffeecnc-jog-stop-request => coffeecnc-jog-inhibit.in-1
net coffeecnc-jog-stop coffeecnc-jog-stop.out => motion.jog-stop
# No jog starts while nothing watches it.
net coffeecnc-jog-inhibit coffeecnc-jog-inhibit.out => motion.jog-inhibit

# Manual tool change: coffeecnc takes the place of hal_manualtoolchange. A configuration may have
# looped these pins back already (LinuxCNC's core_sim.hal does).
unlinkp iocontrol.0.tool-change
unlinkp iocontrol.0.tool-changed
net coffeecnc-tool-change iocontrol.0.tool-change => coffeecnc.tool-change
net coffeecnc-tool-number iocontrol.0.tool-prep-number => coffeecnc.tool-number
net coffeecnc-tool-changed coffeecnc.tool-changed => iocontrol.0.tool-changed
