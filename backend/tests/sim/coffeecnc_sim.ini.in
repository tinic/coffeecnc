# CoffeeCNC's simulated three-axis mill for the adapter tests. No hardware: the HAL files loop the
# commanded position back as feedback. tests/sim/run.sh fills in the @...@ words: @L:n@ is the
# length n millimetres in the machine unit of the run.

[EMC]
VERSION = 1.1
MACHINE = CoffeeCNC-sim
DEBUG = 0

[DISPLAY]
# LinuxCNC starts this program and shuts down when it exits.
DISPLAY = @DISPLAY@
CYCLE_TIME = 0.100
MAX_FEED_OVERRIDE = 1.5
MIN_SPINDLE_OVERRIDE = 0.5
MAX_SPINDLE_OVERRIDE = 1.2
MAX_LINEAR_VELOCITY = @L:30@
PROGRAM_PREFIX = nc_files

[TASK]
TASK = milltask
CYCLE_TIME = 0.001

[RS274NGC]
PARAMETER_FILE = sim.var

[EMCMOT]
EMCMOT = motmod
COMM_TIMEOUT = 1.0
BASE_PERIOD = 0
SERVO_PERIOD = 1000000

[EMCIO]
EMCIO = io
CYCLE_TIME = 0.100
TOOL_TABLE = tool.tbl

[HAL]
# From LinuxCNC's HAL library: motion, position loopback, E-stop loopback.
HALFILE = LIB:core_sim.hal
HALFILE = coffeecnc_sim_home.hal
# Run by the DISPLAY program once its HAL component exists.
POSTGUI_HALFILE = coffeecnc_postgui.hal

[TRAJ]
COORDINATES = X Y Z
LINEAR_UNITS = @UNITS@
ANGULAR_UNITS = degree
DEFAULT_LINEAR_VELOCITY = @L:30@
MAX_LINEAR_VELOCITY = @L:50@
DEFAULT_LINEAR_ACCELERATION = @L:500@
MAX_LINEAR_ACCELERATION = @L:500@

[KINS]
KINEMATICS = trivkins
JOINTS = 3

[SPINDLE_0]
MAX_FORWARD_VELOCITY = 12000
MAX_REVERSE_VELOCITY = 12000

[AXIS_X]
MAX_VELOCITY = @L:30@
MAX_ACCELERATION = @L:500@
MIN_LIMIT = @L:-250@
MAX_LIMIT = @L:250@

[AXIS_Y]
MAX_VELOCITY = @L:30@
MAX_ACCELERATION = @L:500@
MIN_LIMIT = @L:-250@
MAX_LIMIT = @L:250@

[AXIS_Z]
MAX_VELOCITY = @L:30@
MAX_ACCELERATION = @L:500@
MIN_LIMIT = @L:-50@
MAX_LIMIT = @L:100@

# Read by coffeecnc_sim_home.hal.
[COFFEECNC_SIM]
HOME_SWITCH_X = @L:5@
HOME_SWITCH_Y = @L:3@
HOME_SWITCH_Z = @L:8@
HOME_SWITCH_HYSTERESIS = @L:0.05@

[JOINT_0]
TYPE = LINEAR
HOME = 0
MAX_VELOCITY = @L:30@
MAX_ACCELERATION = @L:500@
MIN_LIMIT = @L:-250@
MAX_LIMIT = @L:250@
FERROR = @L:1.27@
MIN_FERROR = @L:0.254@
HOME_OFFSET = 0
HOME_SEARCH_VEL = @L:25@
HOME_LATCH_VEL = @L:5@
HOME_SEQUENCE = 1

[JOINT_1]
TYPE = LINEAR
HOME = 0
MAX_VELOCITY = @L:30@
MAX_ACCELERATION = @L:500@
MIN_LIMIT = @L:-250@
MAX_LIMIT = @L:250@
FERROR = @L:1.27@
MIN_FERROR = @L:0.254@
HOME_OFFSET = 0
HOME_SEARCH_VEL = @L:25@
HOME_LATCH_VEL = @L:5@
HOME_SEQUENCE = 1

[JOINT_2]
TYPE = LINEAR
HOME = 0
MAX_VELOCITY = @L:30@
MAX_ACCELERATION = @L:500@
MIN_LIMIT = @L:-50@
MAX_LIMIT = @L:100@
FERROR = @L:1.27@
MIN_FERROR = @L:0.254@
HOME_OFFSET = @L:8@
HOME_SEARCH_VEL = @L:25@
HOME_LATCH_VEL = @L:5@
HOME_SEQUENCE = 0
