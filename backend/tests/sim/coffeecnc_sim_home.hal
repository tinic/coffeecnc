# Simulated home switches for the CoffeeCNC test mill: one per joint, closed while the joint is
# beyond its switch position. Uses the position signals of LinuxCNC's core_sim.hal.
loadrt comp names=coffeecnc-home-x,coffeecnc-home-y,coffeecnc-home-z,coffeecnc-z-direction
addf coffeecnc-home-x servo-thread
addf coffeecnc-home-y servo-thread
addf coffeecnc-home-z servo-thread
addf coffeecnc-z-direction servo-thread

# Keep the last direction at standstill for tests that model backlash.
setp coffeecnc-z-direction.hyst 0.002
net Zvel => coffeecnc-z-direction.in1
net Z-positive-direction <= coffeecnc-z-direction.out

setp coffeecnc-home-x.in0 [COFFEECNC_SIM]HOME_SWITCH_X
setp coffeecnc-home-y.in0 [COFFEECNC_SIM]HOME_SWITCH_Y
setp coffeecnc-home-z.in0 [COFFEECNC_SIM]HOME_SWITCH_Z
setp coffeecnc-home-x.hyst [COFFEECNC_SIM]HOME_SWITCH_HYSTERESIS
setp coffeecnc-home-y.hyst [COFFEECNC_SIM]HOME_SWITCH_HYSTERESIS
setp coffeecnc-home-z.hyst [COFFEECNC_SIM]HOME_SWITCH_HYSTERESIS

net Xpos => coffeecnc-home-x.in1
net Ypos => coffeecnc-home-y.in1
net Zpos => coffeecnc-home-z.in1
net coffeecnc-home-x coffeecnc-home-x.out => joint.0.home-sw-in
net coffeecnc-home-y coffeecnc-home-y.out => joint.1.home-sw-in
net coffeecnc-home-z coffeecnc-home-z.out => joint.2.home-sw-in
