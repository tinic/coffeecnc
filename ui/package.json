{
  "name": "coffeecnc-ui",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "description": "Operator panel for CoffeeCNC, rendered by the coffeecnc executable's WebKitGTK window",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "check:step": "node scripts/check-step-import.js",
    "check": "vue-tsc --noEmit && eslint . --max-warnings=0 && vitest run"
  },
  "dependencies": {
    "occt-import-js": "0.0.23",
    "three": "0.187.0",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@intlify/unplugin-vue-i18n": "11.2.8",
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
